[Unit]
Description=Isolated Embeint KiCad CI on existing Proxmox build VM
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/kicad-ci/start.sh
ExecStop=/usr/bin/docker stop --time 120 kicad-ci
Restart=always
RestartSec=15
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
